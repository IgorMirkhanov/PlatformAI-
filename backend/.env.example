# Local development backend environment (copy to .env)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/mpai
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
LOG_LEVEL=INFO
OPERATOR_WS_TOKEN=dev-operator-token
WEBHOOK_BASE_URL=http://localhost:8000
# Public HTTPS tunnel for Telegram/Meta webhook registration in local dev
NGROK_TUNNEL_URL=
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_SERVICE_WS_URL=ws://127.0.0.1:3001
CHROMA_SERVER_HOST=127.0.0.1
CHROMA_SERVER_PORT=8001
CHROMA_HOST=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Stripe (wallet top-up + Customer Portal + plan Checkout)
# Use test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
TIPTOP_PUBLIC_ID=
TIPTOP_API_SECRET=
TIPTOP_API_URL=https://api.tiptoppay.kz
# Optional plan prices (subscription Checkout)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
# Webhook endpoints:
#   POST /api/v1/webhooks/payments          (Stripe)
#   POST /api/v1/webhooks/payments/tiptop   (TipTop Pay)
#   POST /api/v1/billing/webhook            (legacy Stripe alias)

# Security — AES-256-GCM at-rest encryption for channel/CRM tokens
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=
# Optional legacy Fernet key (still readable for enc: payloads)
CREDENTIALS_ENCRYPTION_KEY=
ENVIRONMENT=development

# LLM — Groq / OpenRouter free-tier tests
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=openrouter/free
# OPENROUTER_FREE_MODEL=meta-llama/llama-3.2-3b-instruct:free
# LLM_PROVIDER=openrouter

LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400
