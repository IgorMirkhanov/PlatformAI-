      "title": "LLM provider latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_provider_latency_seconds_bucket[5m])) by (le, provider))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "title": "LLM exact-match cache hit rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(mpai_llm_cache_lookups_total{cache_type=\"exact\",result=\"hit\"}[15m])) / clamp_min(sum(rate(mpai_llm_cache_lookups_total{cache_type=\"exact\"}[15m])), 0.001)",
