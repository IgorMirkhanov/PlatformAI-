      "targets": [
        {
          "expr": "sum by (result) (rate(mpai_llm_completions_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
