      "id": 1,
      "title": "HTTP requests by status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (code) (rate(mpai_http_requests_total[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "5xx share",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(mpai_http_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(mpai_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
