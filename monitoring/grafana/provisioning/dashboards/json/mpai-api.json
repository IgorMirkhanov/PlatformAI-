      "title": "Stripe webhook failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(mpai_webhook_failures_total{platform=\"stripe\"}[15m])",
          "legendFormat": "failures / 15m",
          "refId": "A"
        }
      ]
    },
    {
