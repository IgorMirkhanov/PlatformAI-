      "targets": [
        {
          "expr": "sum(rate(mpai_http_requests_total{code=\"402\"}[5m]))",
          "legendFormat": "402 rps",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
