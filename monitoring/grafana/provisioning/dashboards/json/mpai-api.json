      "id": 2,
      "title": "5xx share",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(mpai_http_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(mpai_http_requests_total[5m])), 0.001)",
