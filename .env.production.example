# MP.AI Production Environment — TEMPLATE
#
# Copy to `.env.production` and replace every `replace-me` / placeholder.
# NEVER commit real secrets.
#
# Generate secrets:
#   openssl rand -hex 16   → POSTGRES_PASSWORD / REDIS_PASSWORD
#   openssl rand -hex 32   → JWT_SECRET_KEY / INTERNAL_SERVICE_API_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                          → CREDENTIALS_ENCRYPTION_KEY (Fernet-compatible)
#   # OR 32-byte AES material for ENCRYPTION_KEY (hex):
#   openssl rand -hex 32   → ENCRYPTION_KEY
#
# Multi-tenancy note:
#   Platform keys below are OPTIONAL defaults / OAuth app credentials.
#   Per-customer Telegram / Wazzup / Bitrix / OpenAI / Green-API tokens are stored
#   encrypted (AES-256-GCM) in `bot_channels.encrypted_token` and bot credentials
#   via ENCRYPTION_KEY — do NOT put tenant secrets in this file.

# ── Domain & public URLs ─────────────────────────────────────────────────────
# Commercial deploy REQUIRES public HTTPS for Telegram setWebhook.
# Local Docker may keep http://localhost (Celery getUpdates polling kicks in).
# Prefer both browser origins: http://127.0.0.1 and http://localhost in CORS_ORIGINS.
MPAI_DOMAIN=localhost
WEBHOOK_BASE_URL=https://api.example.com
# Optional tunnel override (local Telegram webhooks):
# NGROK_TUNNEL_URL=https://xxxx.ngrok-free.app
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
ALLOWED_HOSTS=api.example.com,app.example.com
TENANT_BASE_DOMAIN=

# ── Nginx TLS / Let's Encrypt ────────────────────────────────────────────────
SSL_CERT_PATH=./nginx/ssl/fullchain.pem
SSL_KEY_PATH=./nginx/ssl/privkey.pem
CERTBOT_WEBROOT=./nginx/certbot
ALLOW_SELF_SIGNED=0
HTTP_PORT=80
HTTPS_PORT=443

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_SERVER=postgres
POSTGRES_HOST=postgres
POSTGRES_USER=mpai_app
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16
POSTGRES_DB=mpai_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mpai_app:replace-with-openssl-rand-hex-16@postgres:5432/mpai_production

# ── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-openssl-rand-hex-16
REDIS_URL=redis://:replace-with-openssl-rand-hex-16@redis:6379/0
REDIS_MAXMEMORY=1gb
CELERY_BROKER_URL=redis://:replace-with-openssl-rand-hex-16@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-openssl-rand-hex-16@redis:6379/2
CELERY_INBOUND_QUEUE=inbound_messages
CELERY_CRM_QUEUE=crm_actions
# Integration Hub: inbound webhooks + outbound adapter calls (Celery/Redis, not BullMQ).
CELERY_HUB_INBOUND_QUEUE=inbound_messages
CELERY_HUB_OUTBOUND_QUEUE=crm_actions
# Outbound Redis lock (ihub:lock:outbound:{connection_id}); soft job timeout must be < TTL.
HUB_OUTBOUND_LOCK_TTL_SECONDS=90
HUB_OUTBOUND_JOB_TIMEOUT_SECONDS=60
CELERY_QUEUES=inbound_messages,crm_actions
CELERY_CONCURRENCY=4

# ── API / Gunicorn / Auth ────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=production
OPERATOR_WS_TOKEN=op_ws_replace-me
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
INTERNAL_SERVICE_API_KEY=int_srv_replace-me
METRICS_SCRAPE_TOKEN=
ALLOW_SOFT_LAUNCH_AUTH=false
ALLOW_PLAIN_CREDENTIAL_FALLBACK=false
ALLOW_OAUTH_STUB=false

# ── Security / crypto (AES-256-GCM tenant credential vault) ──────────────────
# Required in production. Must DIFFFER from JWT_SECRET_KEY.
# Envelope encryption: KEK lives in ENV (or KMS_KEYS map), never in source.
#   CREDENTIALS_ENCRYPTION_KEY / ENCRYPTION_KEY / MASTER_ENCRYPTION_KEY → KEK v1
#   CREDENTIALS_KEY_VERSION=1
#   Optional multi-version KEK map (JSON object of version → secret material):
#   KMS_KEYS={"1":"replace-with-32-byte-or-hex-secret"}
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-generate-key
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
MASTER_ENCRYPTION_KEY=
CREDENTIALS_KEY_VERSION=1
KMS_KEYS=
AI_GUARDRAILS_ENABLED=true
AI_MODERATION_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RAG_SEARCH_TIMEOUT_SECONDS=8

# ═══════════════════════════════════════════════════════════════════════════════
# LLM & AI PROVIDERS (platform defaults; tenants may BYOK → encrypted in DB)
# ═══════════════════════════════════════════════════════════════════════════════
# Alias accepted by Settings / architecture spec (platform fallback only):
OPENAI_API_KEY=sk-replace-me
PLATFORM_OPENAI_FALLBACK_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Alias accepted by Settings:
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
GROQ_API_KEY=gsk_replace-me
PLATFORM_GROQ_FALLBACK_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-20b

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Prefer paid slug openai/gpt-oss-20b — many ":free" routes return 404 when retired.
OPENROUTER_FREE_MODEL=openai/gpt-oss-20b

LLM_PROVIDER=openrouter
# Single-vendor mode: use "none" (empty may be dropped by Docker Compose → default groq).
FALLBACK_LLM_PROVIDER=none
FALLBACK_LLM_MODEL=openai/gpt-oss-20b
LLM_REQUEST_TIMEOUT_SECONDS=45
EMBEDDING_PROVIDER=auto
REGISTER_WALLET_STARTER_CREDITS=0

# Optional extra vendors
GEMINI_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ═══════════════════════════════════════════════════════════════════════════════
# MESSENGERS & CHANNELS
# Tenant bots encrypt their own tokens in bot_channels — these are platform opts.
# ═══════════════════════════════════════════════════════════════════════════════
# System / sandbox Telegram bot (alias TELEGRAM_DEFAULT_BOT_TOKEN also works)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Wazzup24 (optional platform defaults)
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=
WAZZUP_API_BASE_URL=https://api.wazzup24.com/v3

# Green-API WhatsApp (optional platform defaults)
WHATSAPP_GREENAPI_INSTANCE=
WHATSAPP_GREENAPI_TOKEN=
WHATSAPP_GREENAPI_API_URL=https://api.green-api.com

# WhatsApp Cloud API (Meta) + Baileys QR microservice
WHATSAPP_SERVICE_URL=http://whatsapp_service:3001
WHATSAPP_SERVICE_WS_URL=ws://whatsapp_service:3001
WHATSAPP_SERVICE_PORT=3001
WHATSAPP_LOG_LEVEL=info
WHATSAPP_FASTAPI_WEBHOOK_URL=http://backend_api:8000/api/v1/webhooks/whatsapp-qr
WHATSAPP_API_VERSION=v18.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
FACEBOOK_APP_SECRET=
WHATSAPP_APP_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# CRM SYSTEMS / Integration Hub OAuth
# Tenant Bitrix webhooks / amoCRM tokens are AES-GCM sealed in the vault
# (`credentials` + `integration_connections`). Platform OAuth apps (one per
# provider) live in ENV — tenants never supply client_secret.
#
# Redirect URI (MUST match partner cabinets character-for-character):
#   {WEBHOOK_BASE_URL}/api/v1/integrations/{provider}/callback
# Examples (production API host):
#   https://api.mp.ai/api/v1/integrations/bitrix24/callback
#   https://api.mp.ai/api/v1/integrations/amocrm/callback
# No trailing slash. GET /api/v1/integrations/hub/oauth-redirect-uris returns the live values.
# ═══════════════════════════════════════════════════════════════════════════════
# Bitrix24 (Incoming Webhook — recommended for first launch; OAuth optional)
BITRIX24_WEBHOOK_URL=
# Local/local-app OAuth (optional). Without these, Hub uses Incoming Webhook URL.
BITRIX_APP_ID=
BITRIX_APP_SECRET=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
# Optional override — hub OAuth always uses WEBHOOK_BASE_URL callback paths above.
# Keep this equal to the amocrm callback URL if set (legacy CRM adapters).
AMOCRM_REDIRECT_URI=https://api.mp.ai/api/v1/integrations/amocrm/callback
AMOCRM_BASE_URL=

# Google Calendar / Drive (integrations OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# KNOWLEDGE BASE & VECTORS
# ═══════════════════════════════════════════════════════════════════════════════
CHROMA_SERVER_HOST=chromadb
CHROMA_SERVER_PORT=8000
# Aliases accepted by Settings:
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMA_COLLECTION_NAME=knowledge_base_chunks
CHROMA_PERSIST_DIRECTORY=./data/chroma
# Token auth on the internal Chroma listener. CVE-2026-45830/45831/45833 are
# still unpatched upstream through 1.5.9, so we do not bump the server; we
# require a shared token so the unauthenticated IDOR/RCE surface is not open
# even on the Docker network. openssl rand -hex 32
CHROMA_AUTHN_PROVIDER=chromadb.auth.token_authn.TokenAuthenticationServerProvider
CHROMA_AUTH_TOKEN=replace-with-openssl-rand-hex-32
RAG_TOP_K=3
RAG_MIN_SIMILARITY_SCORE=0.35
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://backend_api:8000
NEXT_PUBLIC_OPERATOR_WS_TOKEN=op_ws_replace-me
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Legal entity (shown in footer / privacy / terms) — fill before GA
NEXT_PUBLIC_COMPANY_LEGAL_NAME=ТОО «MP.AI Platform»
NEXT_PUBLIC_COMPANY_BIN=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_CITY=Алматы
NEXT_PUBLIC_COMPANY_JURISDICTION=Республика Казахстан

# ── Encryption key rotation ──────────────────────────────────────────────────
# Previously active keys, comma-separated. Used for DECRYPTION ONLY so a key
# swap does not orphan stored tokens; writes always use CREDENTIALS_ENCRYPTION_KEY.
# Populate before rotating, run backend/scripts/reencrypt_credentials.py, then
# clear. Full procedure: docs/ops/KEY_ROTATION.md
CREDENTIALS_ENCRYPTION_KEYS_OLD=
# Versioned KEK map for the credentials vault, e.g. {"1":"<old>","2":"<new>"}.
KMS_KEYS=
CREDENTIALS_KEY_VERSION=1

# ── Admin Panel owners ───────────────────────────────────────────────────────
# Comma-separated emails auto-granted is_superadmin on every API start.
# Deployment-specific by design — there is no default, so leaving this empty
# means nobody gets the Admin Panel. Accounts must be registered first.
PLATFORM_SUPERADMIN_EMAILS=owner@example.com

# ── Monitoring (ENABLE_MONITORING=1 ./deploy.sh) ─────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-openssl-rand-hex-16
GRAFANA_ROOT_URL=http://127.0.0.1:3002
PROMETHEUS_RETENTION=15d

# ── Payments (optional) ──────────────────────────────────────────────────────
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_KEY=
TIPTOP_PUBLIC_ID=
TIPTOP_API_SECRET=
TIPTOP_API_URL=https://api.tiptoppay.kz
NEXT_PUBLIC_TIPTOP_PUBLIC_ID=

# ── Resource limits ──────────────────────────────────────────────────────────
PG_CPU_LIMIT=2.0
PG_MEM_LIMIT=2G
PG_MEM_RESERVE=512M
REDIS_CPU_LIMIT=1.0
REDIS_MEM_LIMIT=768M
CHROMA_CPU_LIMIT=1.5
CHROMA_MEM_LIMIT=2G
API_CPU_LIMIT=2.0
API_MEM_LIMIT=2G
CELERY_CPU_LIMIT=2.0
CELERY_MEM_LIMIT=2G
FE_CPU_LIMIT=1.0
FE_MEM_LIMIT=1G
WA_CPU_LIMIT=1.0
WA_MEM_LIMIT=1G
NGINX_CPU_LIMIT=0.5
NGINX_MEM_LIMIT=256M

# ── Container logging ────────────────────────────────────────────────────────
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
IMAGE_TAG=latest
