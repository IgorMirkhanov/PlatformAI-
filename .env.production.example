# MP.AI Production Environment — TEMPLATE
#
# Скопируйте в .env.production и подставьте собственные секреты:
#   openssl rand -hex 16   → POSTGRES_PASSWORD / REDIS_PASSWORD
#   openssl rand -hex 32   → JWT_SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                          → CREDENTIALS_ENCRYPTION_KEY / ENCRYPTION_KEY
# Никогда не коммитьте настоящие значения в этот файл.

# ── Domain & public URLs ─────────────────────────────────────────────────────
# Commercial deploy: set a real public HTTPS origin (or NGROK_TUNNEL_URL).
# http://localhost is OK for local Docker, but Telegram setWebhook will NOT work —
# the API will fall back to Celery getUpdates polling (celery_worker MUST be running).
MPAI_DOMAIN=localhost
WEBHOOK_BASE_URL=http://localhost
# Optional public tunnel override (preferred for local Telegram webhooks):
# NGROK_TUNNEL_URL=https://xxxx.ngrok-free.app
CORS_ORIGINS=http://localhost

# ── Nginx TLS / Let's Encrypt ────────────────────────────────────────────────
SSL_CERT_PATH=./nginx/ssl/fullchain.pem
SSL_KEY_PATH=./nginx/ssl/privkey.pem
CERTBOT_WEBROOT=./nginx/certbot
ALLOW_SELF_SIGNED=1
HTTP_PORT=80
HTTPS_PORT=443

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=mpai_app
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16
POSTGRES_DB=mpai_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mpai_app:replace-with-openssl-rand-hex-16@postgres:5432/mpai_production

# ── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-openssl-rand-hex-16
REDIS_URL=redis://:replace-with-openssl-rand-hex-16@redis:6379/0
REDIS_MAXMEMORY=1gb
CELERY_BROKER_URL=redis://:replace-with-openssl-rand-hex-16@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-openssl-rand-hex-16@redis:6379/2
CELERY_INBOUND_QUEUE=inbound_messages
CELERY_CRM_QUEUE=crm_actions
CELERY_QUEUES=inbound_messages,crm_actions
CELERY_CONCURRENCY=4

# ── API / Gunicorn ───────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO
LOG_FORMAT=json
OPERATOR_WS_TOKEN=op_ws_replace-me
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
INTERNAL_SERVICE_API_KEY=int_srv_replace-me

# ── WhatsApp Baileys microservice ────────────────────────────────────────────
WHATSAPP_SERVICE_URL=http://whatsapp_service:3001
WHATSAPP_SERVICE_WS_URL=ws://whatsapp_service:3001
WHATSAPP_SERVICE_PORT=3001
WHATSAPP_LOG_LEVEL=info
WHATSAPP_FASTAPI_WEBHOOK_URL=http://backend_api:8000/api/v1/webhooks/whatsapp-qr

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_SERVER_HOST=chromadb
CHROMA_SERVER_PORT=8000
CHROMA_COLLECTION_NAME=knowledge_base_chunks

# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq — резервный бесплатный провайдер (фолбэк с OpenRouter при 429 / 5xx /
# timeout / неизвестной модели). Ключ: https://console.groq.com/keys
GROQ_API_KEY=gsk_replace-me
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# OpenRouter (альтернатива; модели с суффиксом :free)
# ⬇️ ВСТАВЬ СЮДА КЛЮЧ OPENROUTER ИЛИ GROQ
OPENAI_API_KEY=sk-or-v1-replace-me
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Состав бесплатного тарифа OpenRouter меняется — проверяйте модель через
# `python scripts/test_llm_connection.py` перед деплоем.
# Алиас openrouter/free резолвится в OPENROUTER_FREE_MODEL.
OPENAI_CHAT_MODEL=openai/gpt-oss-20b:free
OPENROUTER_FREE_MODEL=openai/gpt-oss-20b:free
LLM_PROVIDER=openrouter
# Бесплатный пул OpenRouter даёт всплески до ~30 с на холодном запросе.
LLM_REQUEST_TIMEOUT_SECONDS=45

# Резервный бесплатный провайдер: gateway уходит на него при 429 / 5xx /
# timeout / неизвестной модели у OpenRouter. Ключ: https://console.groq.com/keys
FALLBACK_LLM_PROVIDER=groq
# Список доступных моделей аккаунта: GET https://api.groq.com/openai/v1/models —
# Groq снимает старые слаги (llama-3.1-8b-instant уже отдаёт 404).
FALLBACK_LLM_MODEL=openai/gpt-oss-20b

# Credits granted to OrganizationWallet on POST /auth/register (0 = no starter grant).
REGISTER_WALLET_STARTER_CREDITS=0

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://backend_api:8000
NEXT_PUBLIC_OPERATOR_WS_TOKEN=op_ws_replace-me

# ── Security / crypto ────────────────────────────────────────────────────────
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-generate-key
ENCRYPTION_KEY=replace-with-fernet-generate-key
ENVIRONMENT=production
AI_GUARDRAILS_ENABLED=true
AI_MODERATION_ENABLED=false

# ── Resource limits ──────────────────────────────────────────────────────────
PG_CPU_LIMIT=2.0
PG_MEM_LIMIT=2G
PG_MEM_RESERVE=512M
REDIS_CPU_LIMIT=1.0
REDIS_MEM_LIMIT=768M
CHROMA_CPU_LIMIT=1.5
CHROMA_MEM_LIMIT=2G
API_CPU_LIMIT=2.0
API_MEM_LIMIT=2G
CELERY_CPU_LIMIT=2.0
CELERY_MEM_LIMIT=2G
FE_CPU_LIMIT=1.0
FE_MEM_LIMIT=1G
WA_CPU_LIMIT=1.0
WA_MEM_LIMIT=1G
NGINX_CPU_LIMIT=0.5
NGINX_MEM_LIMIT=256M

# ── Container logging ────────────────────────────────────────────────────────
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
IMAGE_TAG=latest

# ── Observability & payments (production keys) ────────────────────────────────
SENTRY_DSN=
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
TIPTOP_PUBLIC_ID=
TIPTOP_API_SECRET=
TIPTOP_API_URL=https://api.tiptoppay.kz
# Frontend widget (same merchant public id as TIPTOP_PUBLIC_ID)
NEXT_PUBLIC_TIPTOP_PUBLIC_ID=