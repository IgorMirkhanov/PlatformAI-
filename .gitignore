# Secrets / env
.env
.env.local
.env.*.local
.env.production
# Timestamped copies left behind by rotate-encryption-key.ps1 — these hold
# retired key material, so they must never be committed.
.env*.bak-*
!.env.example
!.env.production.example

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/venv/
**/.venv/
backend/.mypy_cache/
backend/.ruff_cache/

# Runtime data: user uploads (receipts/KB files), local Chroma store, e2e fixtures
backend/data/

# Node / Next.js (never commit build artifacts — contain Preview Mode secrets)
**/node_modules/
**/.next/
**/tsconfig.tsbuildinfo
**/out/
**/coverage/
**/playwright-report/
**/test-results/
**/.turbo/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Ops artifacts
backups/
*.sql.gz
nginx/certbot/
nginx/ssl/
*.pem
!docs/**/*.pem.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
