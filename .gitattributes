# Force LF for shell/env/config so Windows checkouts don't break Linux deploy.
# See: CRLF in .env → trailing \r on secrets (POSTGRES_PASSWORD, WEBHOOK_BASE_URL, …).

* text=auto

*.sh          text eol=lf
*.bash        text eol=lf
*.env         text eol=lf
*.env.*       text eol=lf
.env*         text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Dockerfile*   text eol=lf
*.toml        text eol=lf

*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=lf

