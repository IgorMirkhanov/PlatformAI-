# Single-origin MoonAI routing (Next.js rewrites /api/* -> backend)
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_OPERATOR_WS_TOKEN=dev-operator-token
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# TipTop Pay / CloudPayments KZ widget (public merchant id)
NEXT_PUBLIC_TIPTOP_PUBLIC_ID=
